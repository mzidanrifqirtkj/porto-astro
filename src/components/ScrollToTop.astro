---
import {t, type Locale} from '@/i18n/ui';

interface Props {
  locale: Locale;
}

const {locale} = Astro.props;
---

<a
  href="#main"
  data-scroll-top
  aria-label={t(locale, 'ScrollToTop', 'backToTop')}
  hidden
  class="fixed bottom-6 right-6 z-40 rounded-full border border-border bg-surface p-3 text-ink-muted transition-colors hover:border-ink-muted hover:text-ink"
>
  <svg
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 19V5M5 12l7-7 7 7"></path>
  </svg>
</a>

<script>
  const link = document.querySelector<HTMLElement>('[data-scroll-top]');

  if (link) {
    const setVisible = () => {
      link.hidden = window.scrollY <= 600;
    };

    setVisible();
    window.addEventListener('scroll', setVisible, {passive: true});
  }
</script>
