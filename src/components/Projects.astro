---
import {getCollection} from 'astro:content';
import AnimatedSection from '@/components/AnimatedSection.astro';
import ProjectRow from '@/components/ProjectRow.astro';
import {groupByYear} from '@/lib/projects';
import {t, type Locale} from '@/i18n/ui';

interface Props {
  locale: Locale;
}

const {locale} = Astro.props;

const groups = groupByYear(
  await getCollection('projects', ({data}) => data.locale === locale)
);
---

<AnimatedSection id="projects">
  <div class="mx-auto max-w-6xl">
    <h2 class="mb-6 font-display text-2xl text-ink">{t(locale, 'Projects', 'heading')}</h2>

    <div class="flex flex-col gap-10">
      {
        groups.map((group) => (
          <section>
            <h3 class="mb-4 font-mono text-xs uppercase tracking-wide text-ink-muted">
              {group.year}
            </h3>
            <ul class="divide-y divide-border border-t border-border">
              {group.projects.map((project) => (
                <ProjectRow
                  title={project.data.title}
                  description={project.data.description}
                  techStack={project.data.techStack}
                  href={`/${locale}/projects/${project.id.split('/').slice(1).join('/')}`}
                  demoUrl={project.data.demoUrl}
                  githubUrl={project.data.githubUrl}
                />
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</AnimatedSection>
