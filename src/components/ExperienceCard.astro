---
import Chip from '@/components/Chip.astro';
import type {ExperienceRole} from '@/lib/types';

interface Props {
  role: ExperienceRole;
}

const {role} = Astro.props;
---

<div class="border-l-2 border-ink-muted/25 pl-6 transition-colors motion-safe:hover:border-ink-muted/60">
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h3 class="font-display text-lg text-ink">
      {role.role}
      <span class="text-ink-muted">· {role.company}</span>
    </h3>
    <p class="font-mono text-xs text-ink-muted">{role.dateRange}</p>
  </div>
  <p class="mb-3 font-mono text-xs text-ink-muted">{role.location}</p>
  <ul class="mb-4 space-y-1.5">
    {
      role.bullets.map((bullet) => (
        <li class="font-body text-sm leading-relaxed text-ink-muted">{bullet}</li>
      ))
    }
  </ul>
  <div class="flex flex-wrap gap-2">
    {role.techStack.map((tech) => <Chip>{tech}</Chip>)}
  </div>
</div>
