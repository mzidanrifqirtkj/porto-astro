---
import AnimatedSection from '@/components/AnimatedSection.astro';
import {t, type Locale} from '@/i18n/ui';

interface Props {
  locale: Locale;
}

const {locale} = Astro.props;
---

<AnimatedSection id="about" class="bg-surface/20">
  <div class="mx-auto max-w-6xl">
    <h2 class="mb-5 font-display text-3xl text-ink">{t(locale, 'About', 'heading')}</h2>
    <p
      class="max-w-xl font-body text-lg leading-relaxed text-ink-muted lg:max-w-none lg:columns-2 lg:gap-12"
    >
      {t(locale, 'About', 'paragraph')}
    </p>
  </div>
</AnimatedSection>
