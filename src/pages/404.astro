---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout locale="id" title="404 — Halaman tidak ditemukan">
  <section class="px-6 pb-16 pt-40">
    <div class="mx-auto max-w-6xl">
      <p class="mb-3 font-mono text-sm text-ink-muted">// 404</p>
      <h1 class="mb-4 font-display text-3xl text-ink">Halaman tidak ditemukan</h1>
      <a href="/id" class="font-mono text-xs text-ink-muted transition-colors hover:text-ink">
        ← Kembali ke beranda
      </a>
    </div>
  </section>
</BaseLayout>
