---
import {getCollection, render} from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Chip from '@/components/Chip.astro';
import {resolveLocale, t} from '@/i18n/ui';

export async function getStaticPaths() {
  const entries = await getCollection('blog', ({data}) => !data.draft);

  return entries.map((entry) => {
    const [locale, ...rest] = entry.id.split('/');
    return {
      params: {locale, slug: rest.join('/')},
      props: {entry}
    };
  });
}

const locale = resolveLocale(Astro.params.locale);
const {entry} = Astro.props;
const {Content} = await render(entry);

// Finds the translation in the other locale. Slugs are language-specific, so the
// pairing comes from the shared `translationKey`, not from a matching filename.
const translation = entry.data.translationKey
  ? (await getCollection('blog', ({data}) => !data.draft)).find(
      (post) =>
        post.data.translationKey === entry.data.translationKey &&
        post.data.locale !== entry.data.locale
    )
  : undefined;

const translationSlug = translation?.id.split('/').slice(1).join('/');

const dateFormatter = new Intl.DateTimeFormat(locale === 'id' ? 'id-ID' : 'en-US', {
  dateStyle: 'long',
  timeZone: 'UTC'
});
---

<BaseLayout
  locale={locale}
  path={`/blog/${Astro.params.slug}`}
  title={`${entry.data.title} — ${t(locale, 'Meta', 'title')}`}
  description={entry.data.description}
  translationSlug={translationSlug}
  ogImage={entry.data.ogImage ?? undefined}
>
  <article class="px-6 pb-16 pt-40">
    <div class="mx-auto max-w-2xl">
      <a
        href={`/${locale}/blog`}
        class="font-mono text-xs text-ink-muted transition-colors hover:text-ink"
      >
        ← {t(locale, 'Blog', 'backToBlog')}
      </a>

      <p class="mt-8 font-mono text-xs text-ink-muted">
        {t(locale, 'Blog', 'publishedOn', {date: dateFormatter.format(entry.data.date)})}
      </p>
      <h1 class="mt-2 font-display text-3xl text-ink">{entry.data.title}</h1>
      <p class="mt-4 max-w-xl font-body leading-relaxed text-ink-muted">
        {entry.data.description}
      </p>

      {
        entry.data.tags.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2">
            {entry.data.tags.map((tag) => (
              <Chip>{tag}</Chip>
            ))}
          </div>
        )
      }

      <div class="prose-custom mt-10">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>
