---
import {getCollection} from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectRow from '@/components/ProjectRow.astro';
import {groupByYear} from '@/lib/projects';
import {LOCALES, resolveLocale, t} from '@/i18n/ui';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({params: {locale}}));
}

const locale = resolveLocale(Astro.params.locale);

const groups = groupByYear(
  await getCollection('projects', ({data}) => data.locale === locale)
);
---

<BaseLayout
  locale={locale}
  path="/projects"
  title={`${t(locale, 'Projects', 'heading')} — ${t(locale, 'Meta', 'title')}`}
  description={t(locale, 'Projects', 'description')}
>
  <section class="px-6 pb-16 pt-40">
    <div class="mx-auto max-w-6xl">
      <h1 class="mb-8 font-display text-3xl text-ink">{t(locale, 'Projects', 'heading')}</h1>

      <div class="flex flex-col gap-10">
        {
          groups.map((group) => (
            <section>
              <h2 class="mb-4 font-mono text-xs uppercase tracking-wide text-ink-muted">
                {group.year}
              </h2>
              <ul class="divide-y divide-border border-t border-border">
                {group.projects.map((project) => (
                  <ProjectRow
                    title={project.data.title}
                    description={project.data.description}
                    techStack={project.data.techStack}
                    href={`/${locale}/projects/${project.id.split('/').slice(1).join('/')}`}
                    demoUrl={project.data.demoUrl}
                    githubUrl={project.data.githubUrl}
                  />
                ))}
              </ul>
            </section>
          ))
        }
      </div>

      {
        groups.length === 0 && (
          <p class="font-body text-sm text-ink-muted">{t(locale, 'Projects', 'empty')}</p>
        )
      }
    </div>
  </section>
</BaseLayout>
